# Theme (matches tokyonight-night used in tmux/nvim)
theme = TokyoNight Night

# Font
font-family = "FiraCode Nerd Font"
font-size = 14
font-thicken = true
font-feature = -calt

# Window
macos-titlebar-style = hidden

# Locale
env = LANG=en_US.UTF-8
env = LC_ALL=en_US.UTF-8

# Mouse
mouse-scroll-multiplier = discrete:1

# Cmd+h/j/k/l -> Esc+h/j/k/l so tmux's M-hjkl pane-split binds work.
# Keeps .tmux.conf using terminal-agnostic M-hjkl pane split binds.
keybind = cmd+h=esc:h
keybind = cmd+j=esc:j
keybind = cmd+k=esc:k
keybind = cmd+l=esc:l

# C-a C-a -> C-a a. herdr always passes a doubled prefix through as a literal
# C-a, so its last-workspace toggle lives on prefix+a (tmux binds a to match).
# Any other key after C-a is sent through unchanged.
keybind = ctrl+a>ctrl+a=text:\x01a
