{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "lsp": "allow",
    "external_directory": {
        "~/go/pkg/mod/**": "allow",
        "~/go/pkg/sumdb/**": "allow",
        "~/.cargo/registry/src/**": "allow"
    },
    "edit": {
      "~/go/pkg/mod/**": "deny",
      "~/go/pkg/sumdb/**": "deny",  
      "~/.cargo/registry/src/**": "deny"
    }
  },
  "mcp": {
    "tickup": {
      "type": "remote",
      "url": "https://mcp.etl.tickup.net/mcp"
    },
    "clickhouse-docs": {
      "type": "remote",
      "url": "https://clickhouse.mcp.kapa.ai/",
      "oauth": {}
    },
    "ask_polars": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<2",
        "--with",
        "polars",
        "polars-mcp"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN_MCP}"
      }
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "tickup-basedoc": {
      "type": "remote",
      "url": "https://basedoc-mcp.tickup.net/sse"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "infra-basedoc": {
      "type": "remote",
      "url": "https://infradoc.tickup.net/mcp",
    },
    "tickup-docs-wiki": {
        "type": "remote",
        "url": "https://docs.tickup.io/mcp"
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "ty": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  }
}
